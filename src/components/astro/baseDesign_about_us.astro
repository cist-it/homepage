<!DOCTYPE html>
<html lang="ja" dir="ltr">
    <head>
        <meta charset="UTF-8" />
        <!--スマホでも正しい大きさに（いらないかも)-->
        <meta name="viewport" content="width=device-width, initialscale=1.0" />
        <title>About - CIST IT community</title>
        <style>
            /*===全体のリセット・基本設定===*/
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: sans-serif;
                color: #1a1a1a;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /*=== ヘッダー ===*/
            header {
                background: white;
                border-bottom: 1px solid #e5e7eb;
                padding: 1rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            header .logo {
                font-weight: bold;
                font-size:1.2rem;
                color: #6366f1;
            }

            header nav a {
                margin-left: 1.5rem;
                text-decoration: none;
                color: #555;
                font-size: 0.95rem;
            }

            headed nav a:hover {
                color: #6366f1;
            }

            /*===　メインコンテンツ ===*/
            main {
                flex: 1;/*フッターを一番下に押しやるらしいが...? */
            }

            /*=== ヒーローセクション(大きいタイトル) ===*/
            .hero {
                padding: 5rem 2rem;
                /*グラデーション背景できるらしい*/
                background: linear-gradient(135deg, #eef2ff, #faf5ff, #ecfdf5);
                text-align: center;
            }
        </style>  
    </head>

    <body>
        <!-- ヘッダー -->
        <header>
            <div class="logo">CIST IT community</div>
            <nav>
                <!--ハイパーリンク -->
                <a href="/">ホーム</a>
                <a href="/about">About</a>
                <a href="/contact">お問い合わせ</a>
            </nav>
        </header>

        <main>
            <!--[1]ヒーローセクション-->
            <section class="hero">
                <h1>About Us</h1>
                <p>CIST IT communityについて</p>
            </section>

            <!--[2]サークルについて-->
            <section>
                <div class="card">
                    <h2>サークルについて</h2>
                    <p>ここにサークルの説明を入れる。サークルの目的、活動内容、雰囲気等を記す。</p>
                    <p>メンバー構成、活動頻度、主な活動場所。</p>
                    <p>サークルの特徴や魅力を伝える内容を記載。</p>
                </div>
            </section>

            <!--[3]沿革、歴史-->
            <section class="gray-bg" id="history">
                <div class="card">
                    <h2>沿革</h2>

                    <div class="history-item">
                        <div class="history-year">20XX年</div>
                        <div class="history-text">ここにサークル設立の経緯など書く</div>
                    </div>

                    <div class="history-item">
                        <div class="history-year">20XX年</div>
                        <div class="history-text">イベントなど書く</div>
                    </div>

                    <div class="history-item">
                        <div class="history-year">20XX年</div>
                        <div class="history-text">その他情報を書く</div>
                    </div>
                </div>
            </section>

            <!-- [4]理念 -->
            <section id="philosopy">
                <div class="card">
                    <h2>サークル理念</h2>

                    <div class="philosopy-block">
                        <h3>ミッション</h3>
                        <p>サークルが目指すミッション・使命を書く。</p>
                    </div>

                    <div class="philosophy-block">
                        <h3>バリュー</h3>
                        <ul>
                            <li>大切にしている価値観</li>
                            <li>大切にしている価値観</li>
                            <li>大切にしている価値観</li>
                        </ul>
                    </div>
                </div>
            </section>
        </main>

        <!-- フッタ（仮）-->
        <footer>
            <p>© 2026 CIST IT community. All rights reserved.</p>
        </footer>
    </body>
</html>