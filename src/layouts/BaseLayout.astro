---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageData.title}</title>
  </head>
  <body>
    <header><!--ここにヘッダ--></header>
    <h1>{pageData.title}</h1>
    by {pageData.name}
    <p>Written on: {pageData.role}</p>
    <slot />
    <footer><!--ここにフッタ--></footer>
  </body>
</html>
